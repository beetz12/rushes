# Set PUBLIC_BASE_URL to the deployed HTTPS origin. Empty optional provider values are unconfigured.
PUBLIC_BASE_URL=
REVISION=unconfigured
SIGNUP_ENABLED=false
HOSTING_ENABLED=false
DELIVERY_ENABLED=false
ACCOUNT_CAP=25
INVITE_EMAILS=
PILOT_BUDGET_USD=100
PILOT_WARNING_USD=75
STRIPE_LIVE_ENABLED=false
# Supply secrets using provider secret bindings or an ignored private local file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STREAM_CUSTOMER_CODE=
