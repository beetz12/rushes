{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "rushes-browser",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "../browser/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://rushes-browser.nexai-rushes.workers.dev",
    "SIGNUP_ENABLED": "false", "HOSTING_ENABLED": "false", "DELIVERY_ENABLED": "false",
    "STRIPE_LIVE_ENABLED": "false", "ACCOUNT_CAP": "25",
    "PILOT_BUDGET_USD": "100", "PILOT_WARNING_USD": "75"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "invocation_logs": false } }
}
